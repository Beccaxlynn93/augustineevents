{
  // Mirrors the live Worker exactly as it existed on 2026-09-05 (version 7,
  // uploaded by hand 2026-05-15). Verified against the Cloudflare API and
  // against what augustineevents.com actually serves.
  //
  // "name" MUST stay "rough-salad-4d39". Workers Builds requires the name here
  // to match the Worker in the dashboard, or the build fails outright.
  "name": "rough-salad-4d39",

  // Raugustinemusic@gmail.com's Account. Pinned deliberately: the maintainers
  // have access to more than one Cloudflare account, and without this wrangler
  // can silently create a new Worker in the wrong one.
  "account_id": "20da6feefc828587a10b5b232912d1a5",

  // Matches the live version's compatibility_date. Do not bump casually.
  "compatibility_date": "2026-05-15",

  // Enables the *.workers.dev preview URL for non-promoted versions, so a
  // version can be reviewed before it is promoted to production.
  "preview_urls": true,

  // Worker script. Static assets are still matched and served FIRST, so this
  // code only runs for paths that match no file (today: /api/* and 404s).
  // A failure in here cannot take the six static pages down.
  "main": "src/index.js",

  "d1_databases": [
    {
      "binding": "augustine_inquiries",
      "database_name": "augustine-inquiries",
      "database_id": "8233db2a-ce39-4b4e-8447-a8a00da7da6c"
    }
  ],

  "observability": { "enabled": true },

  "assets": {
    "directory": "./",

    // Live behavior: /about.html 307s to /about. Changing this changes every
    // URL on the site.
    "html_handling": "auto-trailing-slash",

    // Live behavior: unmatched paths return a plain 404. There is no 404.html.
    "not_found_handling": "none"
  }
}
